<div class="sb-topbar py-1">
  <div class="container d-flex align-items-center justify-content-center justify-content-lg-between flex-wrap gap-2 py-2">
    <div class="ticker">
      <div class="item is-active">Gratis verzending vanaf €50</div>
      <div class="item">Goed 3.9 uit 5 <i class="bi bi-star-fill"></i> Trustpilot</div>
    </div>
    <div class="d-none d-lg-flex gap-3 flex-wrap">
      <a href="#">Inspiratie</a>
      <a href="#">FAQ</a>
      <a href="#">SupraKaart</a>
      <a href="#">Geboortelijsten</a>
      <a href="#">Jobs</a>
      <a href="#">Contacteer ons</a>
    </div>
  </div>
</div>

<style>
  .ticker{ position:relative; display:grid; }
  .ticker .item{
    grid-area:1 / 1;
    opacity:0;
    visibility:hidden;
    transition:opacity .5s ease;
    white-space:nowrap;
  }
  .ticker .item.is-active{ opacity:1; visibility:visible; }
</style>

<script>
  function initTicker(ticker) {
    const items = ticker.querySelectorAll('.item');
    if (items.length < 2) return;
    let current = 0;
    setInterval(() => {
      items[current].classList.remove('is-active');
      current = (current + 1) % items.length;
      items[current].classList.add('is-active');
    }, 4000);
  }
  document.querySelectorAll('.ticker').forEach(initTicker);
</script>
