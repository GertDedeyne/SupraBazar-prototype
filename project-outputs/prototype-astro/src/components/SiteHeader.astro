<header class="sb-header py-3">
  <div class="container py-2">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
      <a href="#" class="icon-link-item d-lg-none"><i class="bi bi-list"></i><span class="d-none d-lg-inline">Menu</span></a>

      <a href={import.meta.env.BASE_URL} class="sb-logo text-decoration-none">SupraBazar<small>Je vindt er alles.</small></a>

      <div class="flex-grow-1 mx-3 d-none d-lg-block" style="max-width:480px;">
        <div class="input-group">
          <input type="text" class="form-control" placeholder="Waar ben je naar op zoek?">
          <button class="btn btn-light border" type="button"><i class="bi bi-search"></i></button>
        </div>
      </div>

      <div class="d-flex icon-link-group">
        <a href="#" class="icon-link-item d-none d-lg-flex"><i class="bi bi-geo-alt"></i><span>Winkels</span></a>
        <a href="#" class="icon-link-item"><i class="bi bi-heart"></i><span class="d-none d-lg-inline">Wenslijst</span></a>
        <a href={`${import.meta.env.BASE_URL}account/login.html`} class="icon-link-item"><i class="bi bi-person"></i><span class="d-none d-lg-inline">Account</span></a>
        <a href="#" class="icon-link-item"><i class="bi bi-cart3"></i><span class="d-none d-lg-inline">Winkelmandje</span></a>
      </div>
    </div>

    <div class="mt-3 d-lg-none">
      <div class="input-group">
        <input type="text" class="form-control" placeholder="Waar ben je naar op zoek?">
        <button class="btn btn-light border" type="button"><i class="bi bi-search"></i></button>
      </div>
    </div>
  </div>
</header>
