---
const { active } = Astro.props;
const base = import.meta.env.BASE_URL;

const links = [
  { slug: 'overzicht', href: `${base}account/overzicht.html`, icon: 'bi-grid', label: 'Overzicht' },
  { slug: 'bestellingen', href: `${base}account/bestellingen.html`, icon: 'bi-box-seam', label: 'Bestellingen' },
  { slug: 'adressen', href: `${base}account/adressen.html`, icon: 'bi-geo-alt', label: 'Adressen' },
  { slug: 'betaalwijzen', href: `${base}account/betaalwijzen.html`, icon: 'bi-credit-card', label: 'Betaalwijzen' },
  { slug: 'cadeaubonnen', href: `${base}account/cadeaubonnen.html`, icon: 'bi-gift', label: 'Cadeaubonnen' },
  { slug: 'profiel', href: `${base}account/profiel.html`, icon: 'bi-person', label: 'Gegevens en voorkeuren' },
];
---
<div class="account-nav-panel">
  <button type="button" class="account-nav-toggle btn w-100 d-flex d-lg-none justify-content-between align-items-center" data-bs-toggle="collapse" data-bs-target="#accountNavCollapse" aria-expanded="false" aria-controls="accountNavCollapse">
    <span class="fw-semibold">Jouw account</span>
    <i class="bi bi-chevron-down"></i>
  </button>
  <div class="collapse d-lg-block" id="accountNavCollapse">
    <nav class="account-nav nav nav-pills flex-column small">
      {links.map((link) => (
        <a href={link.href} class:list={['nav-link', { active: link.slug === active }]}>
          <i class={`bi ${link.icon}`}></i> {link.label}
        </a>
      ))}
    </nav>
    <a href={`${base}account/login.html`} class="logout small d-block mt-4 px-3 pb-2">Afmelden</a>
  </div>
</div>

<script>
  (function(){
    var collapseEl = document.getElementById('accountNavCollapse');
    var toggleBtn = document.querySelector('.account-nav-toggle');
    var toggleIcon = toggleBtn ? toggleBtn.querySelector('i') : null;
    if (!collapseEl || !toggleIcon) return;

    collapseEl.addEventListener('show.bs.collapse', function(){
      toggleIcon.classList.replace('bi-chevron-down', 'bi-chevron-up');
    });
    collapseEl.addEventListener('hide.bs.collapse', function(){
      toggleIcon.classList.replace('bi-chevron-up', 'bi-chevron-down');
    });
  })();
</script>
