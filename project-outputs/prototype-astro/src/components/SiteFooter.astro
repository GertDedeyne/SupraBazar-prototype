<footer class="sb-footer pt-5">
  <div class="container">
    <div class="row sb-footer-usps pb-4 mb-4 gy-4">
      <div class="col-12 col-md-6 col-lg-3 d-flex flex-column gap-2 align-items-center text-center">
        <i class="bi bi-box-seam"></i>
        <div><div class="footer-usp-title">Groot aanbod</div><div class="footer-usp-desc">Meer dan 150.000 producten online<br>5 winkels</div></div>
      </div>
      <div class="col-12 col-md-6 col-lg-3 d-flex flex-column gap-2 align-items-center text-center">
        <i class="bi bi-truck"></i>
        <div><div class="footer-usp-title">Aan huis geleverd</div><div class="footer-usp-desc">Gratis levering vanaf € 50<br>Geleverd binnen 1-2 werkdagen</div></div>
      </div>
      <div class="col-12 col-md-6 col-lg-3 d-flex flex-column gap-2 align-items-center text-center">
        <i class="bi bi-shield-check"></i>
        <div><div class="footer-usp-title">Veilig betalen</div><div class="footer-usp-desc">Bancontact, iDEAL,<br>Klarna, Visa, Mastercard</div></div>
      </div>
      <div class="col-12 col-md-6 col-lg-3 d-flex flex-column gap-2 align-items-center text-center">
        <i class="bi bi-headset"></i>
        <div><div class="footer-usp-title">Dienst na verkoop</div><div class="footer-usp-desc">shop@suprabazar.be<br>+32 56 43 97 75</div></div>
      </div>
    </div>
  </div>

  <div class="sb-footer-trustpilot py-4 text-center">
    <div class="container d-none d-lg-flex flex-wrap justify-content-center align-items-center gap-2">
      <span class="pe-2">Onze klanten zeggen</span>
      <strong>Goed</strong>
      <span class="trustpilot-stars" aria-label="3.9 uit 5 sterren">
        <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-half"></i>
      </span>
      <span class="footer-usp-desc">3.9 uit 5 op basis van <a class="footer-link" href="#">62 reviews</a></span>
      <span class="d-inline-flex align-items-center gap-1"><i class="bi bi-star-fill"></i> Trustpilot</span>
    </div>

    <div class="container d-flex d-lg-none flex-column align-items-center gap-2">
      <span>Onze klanten zeggen</span>
      <div class="d-flex flex-wrap justify-content-center align-items-center gap-2">
        <strong>Goed</strong>
        <span class="trustpilot-stars" aria-label="3.9 uit 5 sterren">
          <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-half"></i>
        </span>
        <span class="d-inline-flex align-items-center gap-1"><i class="bi bi-star-fill"></i> Trustpilot</span>
      </div>
    </div>
  </div>

  <div class="sb-footer-cta py-4">
    <div class="container d-flex flex-column flex-lg-row align-items-center justify-content-lg-between gap-3 text-center text-lg-start">
      <div class="d-flex flex-column flex-lg-row align-items-center gap-2 gap-lg-3 text-center text-lg-start">
        <span class="sb-footer-cta-title mb-0">Hulp nodig?</span>
        <span class="d-none d-lg-inline">shop@suprabazar.be&nbsp;&nbsp;|&nbsp;&nbsp;+32 56 43 97 75</span>
      </div>
      <div class="d-flex flex-column flex-md-row align-items-center justify-content-md-between gap-2 gap-md-3 w-100 text-center text-md-start d-lg-none">
        <span>shop@suprabazar.be&nbsp;&nbsp;|&nbsp;&nbsp;+32 56 43 97 75</span>
        <button class="btn btn-light " type="button">Contacteer ons</button>
      </div>
      <button class="btn btn-light d-none d-lg-inline-block" type="button">Contacteer ons</button>
    </div>
  </div>

  <div class="container pt-4">
    <div class="row gy-4">
      <div class="col-12 d-md-none">
        <div class="accordion sb-footer-accordion" id="footerAccordion">
          <div class="accordion-item">
            <h2 class="accordion-header">
              <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#footerAccOver" aria-expanded="false" aria-controls="footerAccOver">Over Supra Bazar</button>
            </h2>
            <div id="footerAccOver" class="accordion-collapse collapse" data-bs-parent="#footerAccordion">
              <div class="accordion-body">
                <ul class="list-unstyled d-flex flex-column gap-2 mb-0">
                  <li><a class="footer-link" href="#">Wie zijn wij</a></li>
                  <li><a class="footer-link" href="#">Onze winkels</a></li>
                  <li><a class="footer-link" href="#">FAQ</a></li>
                  <li><a class="footer-link" href="#">SupraKaart</a></li>
                  <li><a class="footer-link" href="#">Folder</a></li>
                  <li><a class="footer-link" href="#">Jobs</a></li>
                  <li><a class="footer-link" href="#">Contacteer ons</a></li>
                  <li><a class="footer-link" href="#">Geboortelijsten</a></li>
                </ul>
              </div>
            </div>
          </div>
          <div class="accordion-item">
            <h2 class="accordion-header">
              <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#footerAccWebshop" aria-expanded="false" aria-controls="footerAccWebshop">Onze webshop</button>
            </h2>
            <div id="footerAccWebshop" class="accordion-collapse collapse" data-bs-parent="#footerAccordion">
              <div class="accordion-body">
                <ul class="list-unstyled d-flex flex-column gap-2 mb-0">
                  <li><a class="footer-link" href="#">Levering</a></li>
                  <li><a class="footer-link" href="#">Retourneren</a></li>
                  <li><a class="footer-link" href="#">Betalen</a></li>
                  <li><a class="footer-link" href="#">Gebruiksvoorwaarden</a></li>
                  <li><a class="footer-link" href="#">Privacy</a></li>
                  <li><a class="footer-link" href="#">Cookie instellingen</a></li>
                  <li><a class="footer-link" href="#">Digitale cadeaubon</a></li>
                  <li><a class="footer-link" href="#">B2B Sintlijstje</a></li>
                </ul>
              </div>
            </div>
          </div>
          <div class="accordion-item">
            <h2 class="accordion-header">
              <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#footerAccUren" aria-expanded="false" aria-controls="footerAccUren">Openingsuren</button>
            </h2>
            <div id="footerAccUren" class="accordion-collapse collapse" data-bs-parent="#footerAccordion">
              <div class="accordion-body">
                <ul class="list-unstyled sb-footer-hours d-flex flex-column gap-2 mb-0">
                  <li><span>Maandag</span><span>13u00–18u30</span></li>
                  <li><span>Di t/m vrij</span><span>9u00–18u30</span></li>
                  <li><span>Zaterdag</span><span>9u00–18u00</span></li>
                  <li><span>Zondag</span><span>9u00–12u00</span></li>
                </ul>
                <div class="footer-usp-desc mt-2">Gesloten op feestdagen</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="col-6 col-md-4 col-lg-2 d-none d-md-block">
        <div class="sb-footer-heading">Over Supra Bazar</div>
        <ul class="list-unstyled d-flex flex-column gap-2 mb-0">
          <li><a class="footer-link" href="#">Wie zijn wij</a></li>
          <li><a class="footer-link" href="#">Onze winkels</a></li>
          <li><a class="footer-link" href="#">FAQ</a></li>
          <li><a class="footer-link" href="#">SupraKaart</a></li>
          <li><a class="footer-link" href="#">Folder</a></li>
          <li><a class="footer-link" href="#">Jobs</a></li>
          <li><a class="footer-link" href="#">Contacteer ons</a></li>
          <li><a class="footer-link" href="#">Geboortelijsten</a></li>
        </ul>
      </div>
      <div class="col-6 col-md-4 col-lg-2 d-none d-md-block">
        <div class="sb-footer-heading">Onze webshop</div>
        <ul class="list-unstyled d-flex flex-column gap-2 mb-0">
          <li><a class="footer-link" href="#">Levering</a></li>
          <li><a class="footer-link" href="#">Retourneren</a></li>
          <li><a class="footer-link" href="#">Betalen</a></li>
          <li><a class="footer-link" href="#">Gebruiksvoorwaarden</a></li>
          <li><a class="footer-link" href="#">Privacy</a></li>
          <li><a class="footer-link" href="#">Cookie instellingen</a></li>
          <li><a class="footer-link" href="#">Digitale cadeaubon</a></li>
          <li><a class="footer-link" href="#">B2B Sintlijstje</a></li>
        </ul>
      </div>
      <div class="col-6 col-md-4 col-lg-2 d-none d-md-block">
        <div class="sb-footer-heading">Openingsuren</div>
        <ul class="list-unstyled sb-footer-hours d-flex flex-column gap-2 mb-0">
          <li><span>Maandag</span><span>13u00–18u30</span></li>
          <li><span>Di t/m vrij</span><span>9u00–18u30</span></li>
          <li><span>Zaterdag</span><span>9u00–18u00</span></li>
          <li><span>Zondag</span><span>9u00–12u00</span></li>
        </ul>
        <div class="footer-usp-desc mt-2">Gesloten op feestdagen</div>
      </div>

      <div class="col-12 col-md-12 col-lg-5 offset-lg-1">
          <div class="sb-footer-heading">Nieuwsbrief abonneren</div>
          <form class="d-flex flex-column gap-2">
            <div class="d-flex gap-2">
              <input type="email" class="form-control form-control-sm" placeholder="E-mailadres">
              <button class="btn btn-dark" type="submit">Verzenden</button>
            </div>
            <div class="d-flex align-items-center gap-2">
              <div class="captcha-image" aria-hidden="true">tBb8G32</div>
              <button class="btn btn-outline-secondary btn-sm" type="button" aria-label="Vernieuw captcha"><i class="bi bi-arrow-repeat"></i></button>
            </div>
            <label class="footer-usp-desc mb-0" for="newsletter-captcha">Voer de hierboven getoonde tekens in*</label>
            <input type="text" class="form-control form-control-sm" id="newsletter-captcha">
            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="newsletter-privacy" required>
              <label class="form-check-label footer-usp-desc" for="newsletter-privacy">Ik heb de privacybepalingen gelezen.</label>
            </div>
          </form>
      </div>
    </div>

    <div class="d-flex align-items-center gap-3 py-4 border-top mt-4" style="border-color:var(--g-line);">
      <span class="sb-footer-heading mb-0">Volg ons</span>
      <div class="d-flex gap-2 sb-footer-social">
        <a href="#" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
        <a href="#" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
      </div>
      <button class="back-to-top d-flex align-items-center justify-content-center ms-auto" type="button" aria-label="Terug naar boven" onclick="window.scrollTo({top:0,behavior:'smooth'})"><i class="bi bi-arrow-up"></i></button>
    </div>
  </div>
</footer>
