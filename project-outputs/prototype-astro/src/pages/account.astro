---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="SupraBazar | Account">

<div class="container py-4 account-main-container">
  <div class="row g-4">
    <aside class="col-lg-3">
      <div class="account-nav-panel">
        <button type="button" class="account-nav-toggle btn w-100 d-flex d-lg-none justify-content-between align-items-center" data-bs-toggle="collapse" data-bs-target="#accountNavCollapse" aria-expanded="false" aria-controls="accountNavCollapse">
          <span class="fw-semibold">Jouw account</span>
          <i class="bi bi-chevron-down"></i>
        </button>
        <div class="collapse d-lg-block" id="accountNavCollapse">
          <nav class="account-nav nav nav-pills flex-column small">
            <a href="#" class="nav-link active" data-bs-toggle="pill" data-bs-target="#pane-overzicht" role="tab"><i class="bi bi-grid"></i> Overzicht</a>
            <a href="#" class="nav-link" data-bs-toggle="pill" data-bs-target="#pane-profiel" role="tab"><i class="bi bi-person"></i> Jouw profiel</a>
            <a href="#" class="nav-link" data-bs-toggle="pill" data-bs-target="#pane-adressen" role="tab"><i class="bi bi-geo-alt"></i> Adressen</a>
            <a href="#" class="nav-link" data-bs-toggle="pill" data-bs-target="#pane-betaalwijzen" role="tab"><i class="bi bi-credit-card"></i> Betaalwijzen</a>
            <a href="#" class="nav-link" data-bs-toggle="pill" data-bs-target="#pane-bestellingen" role="tab"><i class="bi bi-box-seam"></i> Bestellingen</a>
            <a href="#" class="nav-link" data-bs-toggle="pill" data-bs-target="#pane-cadeaubonnen" role="tab"><i class="bi bi-gift"></i> Cadeaubonnen</a>
          </nav>
          <a href="#" class="logout small d-block mt-4 px-3 pb-2">Afmelden</a>
        </div>
      </div>
    </aside>

    <main class="col-lg-9">
      <div class="tab-content">

        <div class="tab-pane fade show active" id="pane-overzicht" role="tabpanel">
          <h1 class="h3 mb-4">Overzicht</h1>

          <div class="row g-4 mb-4">
            <div class="col-md-4">
              <div class="account-card h-100 p-3 d-flex flex-column">
                <div class="card-title-label">Persoonlijke gegevens</div>
                <div class="welcome-text mb-0">Welkom</div>
                <p class="h4 mb-1">Mr. John Smith</p>
                <p class="text-muted mb-3 small">john.smith@iodigital.com</p>
                <a href="#" class="btn btn-light mt-auto align-self-start js-tab-link" data-bs-target="#pane-profiel">Bekijk profiel</a>
              </div>
            </div>

            <div class="col-md-4">
              <div class="account-card h-100 p-3 d-flex flex-column">
                <div class="card-title-label">Nieuwsbrief</div>
                <div class="welcome-text mb-0">Nieuwsbrief</div>
                <p class="text-muted mb-3 small">Blijf op de hoogte van nieuws en aanbiedingen.</p>
                <div class="mt-auto d-flex justify-content-between align-items-center gap-3">
                  <div>
                    <div id="newsletter-status">Ingeschreven</div>
                    <div class="small text-muted" id="newsletter-subtext">Je ontvangt onze nieuwsbrief</div>
                  </div>
                  <div class="form-check form-switch mb-0 flex-shrink-0">
                    <input class="form-check-input" type="checkbox" role="switch" id="newsletter-toggle" checked>
                  </div>
                </div>
              </div>
            </div>

            <div class="col-md-4">
              <div class="suprakaart-card h-100 p-3 d-flex flex-column">
                <div class="card-title-label">Digitale cadeaubon</div>
                <div class="giftcard-balance">€ 37,50 totaal</div>
                <div class="small opacity-75 mb-1">2 cadeaubonnen</div>
                <div class="mt-auto d-flex flex-column gap-2 align-items-start pt-4">
                  <a href="#" class="btn btn-light js-tab-link" data-bs-target="#pane-cadeaubonnen">Alle cadeaubonnen</a>
                </div>
              </div>
            </div>
          </div>

          <!-- Laatste bestelling -->
          <h2 class="h4 mt-5 mb-4">Actieve bestellingen</h2>

          <div class="order-card p-3 mb-2">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <div>
                <div>Bestelling: 26 aug 2026</div>
                <div class="small text-muted mb-2">Bestelnummer: 343314785 · 2 artikelen · <strong>€ 47,96</strong></div>
                <span class="badge-status badge-shipped"><i class="bi bi-truck"></i> Verzonden</span>
              </div>
              <a href="#" class="link-secondary small">Details tonen</a>
            </div>

            <div class="stepper my-3">
              <div class="dot done"><i class="bi bi-check"></i></div><div class="bar done"></div>
              <div class="dot done"><i class="bi bi-check"></i></div><div class="bar done"></div>
              <div class="dot current"></div><div class="bar"></div>
              <div class="dot"></div>
            </div>
            <div class="d-flex justify-content-between stepper-label mb-3">
              <span>Bevestigd</span><span>Verwerkt</span><span>Verzonden</span><span>Geleverd</span>
            </div>
          </div>
          <div class="annot mb-4">Quick win #1 — status badge (icon + label, no color-coding) + stepper replaces plain-text"Shipped/Paid" (status shown here still needs to sync to real carrier state, per ux-improvements.md — data dependency, not UI)<span class="qw-badge">QW1</span></div>

          <!-- Bestellingen preview -->
          <h2 class="h4 mt-5 mb-4">Bestellingen</h2>

          <div class="order-card p-3 mb-3">
            <div class="d-flex justify-content-between align-items-start">
              <div>
                <div>Bestelling: 26 aug 2026</div>
                <div class="small text-muted mb-2">Bestelnummer: 343314785 · 2 artikelen · <strong>€ 47,96</strong></div>
                <div class="d-flex align-items-center gap-2">
                  <span class="badge-status badge-delivered"><i class="bi bi-check-circle"></i> Geleverd</span>
                  <a href="#" class="btn-return">Retour aanvragen</a>
                </div>
              </div>
              <a href="#" class="link-secondary small">Details tonen</a>
            </div>
          </div>

          <div class="order-card p-3 mb-3">
            <div class="d-flex justify-content-between align-items-start">
              <div>
                <div>Bestelling: 26 aug 2026</div>
                <div class="small text-muted mb-2">Bestelnummer: 343308511 · 1 artikel · <strong>€ 22,49</strong></div>
                <div class="d-flex align-items-center gap-2">
                  <span class="badge-status badge-delivered"><i class="bi bi-check-circle"></i> Geleverd</span>
                  <a href="#" class="btn-return">Retour aanvragen</a>
                </div>
              </div>
              <a href="#" class="link-secondary small">Details tonen</a>
            </div>
          </div>

          <a href="#" class="btn btn-light js-tab-link" data-bs-target="#pane-bestellingen">Alle bestellingen</a>
        </div>

        <div class="tab-pane fade" id="pane-bestellingen" role="tabpanel">
          <h1 class="h3 mb-4">Bestellingen</h1>

          <h2 class="h4 mb-4">Actieve bestellingen</h2>

          <div class="order-card p-3 mb-2">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <div>
                <div>Bestelling: 26 aug 2026</div>
                <div class="small text-muted mb-2">Bestelnummer: 343314785 · 2 artikelen · <strong>€ 47,96</strong></div>
                <span class="badge-status badge-shipped"><i class="bi bi-truck"></i> Verzonden</span>
              </div>
              <a href="#" class="link-secondary small">Details tonen</a>
            </div>

            <div class="stepper my-3">
              <div class="dot done"><i class="bi bi-check"></i></div><div class="bar done"></div>
              <div class="dot done"><i class="bi bi-check"></i></div><div class="bar done"></div>
              <div class="dot current"></div><div class="bar"></div>
              <div class="dot"></div>
            </div>
            <div class="d-flex justify-content-between stepper-label mb-3">
              <span>Bevestigd</span><span>Verwerkt</span><span>Verzonden</span><span>Geleverd</span>
            </div>
          </div>
          <div class="annot mb-4">Quick win #1 — status badge (icon + label, no color-coding) + stepper replaces plain-text"Shipped/Paid" (status shown here still needs to sync to real carrier state, per ux-improvements.md — data dependency, not UI)<span class="qw-badge">QW1</span></div>

          <h2 class="h4 mt-5 mb-4">Bestellingen</h2>

          <div class="order-card p-3 mb-3">
            <div class="d-flex justify-content-between align-items-start">
              <div>
                <div>Bestelling: 26 aug 2026</div>
                <div class="small text-muted mb-2">Bestelnummer: 343314785 · 2 artikelen · <strong>€ 47,96</strong></div>
                <div class="d-flex align-items-center gap-2">
                  <span class="badge-status badge-delivered"><i class="bi bi-check-circle"></i> Geleverd</span>
                  <a href="#" class="btn-return">Retour aanvragen</a>
                </div>
              </div>
              <a href="#" class="link-secondary small">Details tonen</a>
            </div>
          </div>

          <div class="order-card p-3 mb-3">
            <div class="d-flex justify-content-between align-items-start">
              <div>
                <div>Bestelling: 26 aug 2026</div>
                <div class="small text-muted mb-2">Bestelnummer: 343308511 · 1 artikel · <strong>€ 22,49</strong></div>
                <div class="d-flex align-items-center gap-2">
                  <span class="badge-status badge-delivered"><i class="bi bi-check-circle"></i> Geleverd</span>
                  <a href="#" class="btn-return">Retour aanvragen</a>
                </div>
              </div>
              <a href="#" class="link-secondary small">Details tonen</a>
            </div>
          </div>

          <div class="order-card p-3 mb-3">
            <div class="d-flex justify-content-between align-items-start">
              <div>
                <div>Bestelling: 12 aug 2026</div>
                <div class="small text-muted mb-2">Bestelnummer: 343201044 · 3 artikelen · <strong>€ 68,90</strong></div>
                <span class="badge-status badge-cancelled"><i class="bi bi-x-circle"></i> Geannuleerd</span>
              </div>
              <a href="#" class="link-secondary small">Details tonen</a>
            </div>
          </div>

          <div class="order-card p-3 mb-3">
            <div class="d-flex justify-content-between align-items-start">
              <div>
                <div>Bestelling: 3 aug 2026</div>
                <div class="small text-muted mb-2">Bestelnummer: 343187622 · 1 artikel · <strong>€ 15,99</strong></div>
                <div class="d-flex align-items-center gap-2">
                  <span class="badge-status badge-delivered"><i class="bi bi-check-circle"></i> Geleverd</span>
                  <a href="#" class="btn-return">Retour aanvragen</a>
                </div>
              </div>
              <a href="#" class="link-secondary small">Details tonen</a>
            </div>
          </div>

          <div class="order-card p-3 mb-3">
            <div class="d-flex justify-content-between align-items-start">
              <div>
                <div>Bestelling: 27 jul 2026</div>
                <div class="small text-muted mb-2">Bestelnummer: 343159087 · 4 artikelen · <strong>€ 102,35</strong></div>
                <div class="d-flex align-items-center gap-2">
                  <span class="badge-status badge-delivered"><i class="bi bi-check-circle"></i> Geleverd</span>
                  <a href="#" class="btn-return">Retour aanvragen</a>
                </div>
              </div>
              <a href="#" class="link-secondary small">Details tonen</a>
            </div>
          </div>

          <div class="annot mb-4">Quick win #3 — order total + item count/thumbnail visible without expanding"Tonen"; status now distinguished by icon + label (not color) so it also works for colorblind users and print/greyscale contexts<span class="qw-badge">QW3</span></div>

          <nav class="mt-2" aria-label="pagination">
            <ul class="pagination justify-content-center">
              <li class="page-item active"><a class="page-link" href="#" style="background:var(--g-darkest); border-color:var(--g-darkest);">1</a></li>
              <li class="page-item"><a class="page-link text-dark" href="#">2</a></li>
              <li class="page-item"><a class="page-link text-dark" href="#">3</a></li>
              <li class="page-item"><a class="page-link text-dark" href="#">Volgende</a></li>
            </ul>
          </nav>
        </div>

        <div class="tab-pane fade" id="pane-cadeaubonnen" role="tabpanel">
          <h1 class="h3 mb-4">Cadeaubonnen</h1>

          <form class="d-flex gap-2 mb-4" style="max-width:420px;">
            <input type="text" class="form-control" placeholder="Voer cadeaubon code in">
            <button class="btn btn-dark" type="submit">Toevoegen</button>
          </form>

          <div class="mb-2">Actief (2)</div>

          <div class="order-card p-3 mb-3">
            <div class="d-flex justify-content-between align-items-start">
              <div>
                <div>Cadeaubon •••• 4821</div>
                <div class="small text-muted mb-2">Saldo: € 25,00 · Geldig tot 12/2026</div>
                <span class="badge-status badge-active"><i class="bi bi-check-circle"></i> Actief</span>
              </div>
              <a href="#" class="link-secondary small">Details tonen</a>
            </div>
          </div>

          <div class="order-card p-3 mb-4">
            <div class="d-flex justify-content-between align-items-start">
              <div>
                <div>Cadeaubon •••• 9902</div>
                <div class="small text-muted mb-2">Saldo: € 12,50 · Geldig tot 03/2027</div>
                <span class="badge-status badge-active"><i class="bi bi-check-circle"></i> Actief</span>
              </div>
              <a href="#" class="link-secondary small">Details tonen</a>
            </div>
          </div>

          <a href="#" class="mb-2 d-inline-flex align-items-center gap-1 text-decoration-none link-secondary" data-bs-toggle="collapse" data-bs-target="#cadeaubonnen-verlopen">
            Verlopen of gebruikt (1) <i class="bi bi-chevron-down small"></i>
          </a>

          <div class="collapse" id="cadeaubonnen-verlopen">
            <div class="order-card order-card-muted p-3 mb-3 mt-2">
              <div class="d-flex justify-content-between align-items-start">
                <div>
                  <div>Cadeaubon •••• 1187</div>
                  <div class="small text-muted mb-2">Saldo: € 0,00 · Verlopen op 05/2026</div>
                  <span class="badge-status badge-expired"><i class="bi bi-x-circle"></i> Verlopen</span>
                </div>
                <a href="#" class="link-secondary small">Details tonen</a>
              </div>
            </div>
          </div>

          <div class="annot mb-4">New"Cadeaubonnen" tab — models multiple gift cards individually (code, balance, expiry, status) instead of one aggregate balance, per audit finding on missing gift card management<span class="qw-badge">QW6</span></div>
        </div>

        <div class="tab-pane fade" id="pane-profiel" role="tabpanel">
          <h1 class="h3 mb-4">Jouw profiel</h1>

          <nav class="nav nav-tabs mb-4" role="tablist">
            <a href="#" class="nav-link active" data-bs-toggle="tab" data-bs-target="#pane-profiel-gegevens" role="tab" aria-selected="true">Persoonlijke gegevens</a>
            <a href="#" class="nav-link" data-bs-toggle="tab" data-bs-target="#pane-profiel-email" role="tab" aria-selected="false">E-mailadres</a>
          </nav>

          <div class="tab-content">

            <div class="tab-pane fade show active" id="pane-profiel-gegevens" role="tabpanel">
              <form class="col-md-8">
                <div class="mb-3">
                  <label class="form-label" for="profiel-ikben">Ik ben <span class="text-danger">*</span></label>
                  <select class="form-select" id="profiel-ikben">
                    <option>Particulier</option>
                    <option>Zakelijk</option>
                  </select>
                </div>

                <div class="mb-3">
                  <label class="form-label" for="profiel-aanhef">Aanhef</label>
                  <select class="form-select" id="profiel-aanhef">
                    <option>Mr.</option>
                    <option>Mevr.</option>
                  </select>
                </div>

                <div class="mb-3">
                  <label class="form-label" for="profiel-voornaam">Voornaam <span class="text-danger">*</span></label>
                  <input type="text" class="form-control" id="profiel-voornaam" value="Gert">
                </div>

                <div class="mb-3">
                  <label class="form-label" for="profiel-familienaam">Familienaam <span class="text-danger">*</span></label>
                  <input type="text" class="form-control" id="profiel-familienaam" value="Dedeyne">
                </div>

                <p class="small text-muted">Velden gemarkeerd met asterisks (*) zijn verplicht.</p>

                <button class="btn btn-dark" type="submit">Wijzigingen opslaan</button>
              </form>
            </div>

            <div class="tab-pane fade" id="pane-profiel-email" role="tabpanel">
              <form class="col-md-8">
                <p class="mb-3"><strong>E-mailadres:</strong> gert.dedeyne@iodigital.com</p>

                <div class="mb-3">
                  <label class="form-label" for="profiel-email-nieuw">E-mailadres <span class="text-danger">*</span></label>
                  <input type="email" class="form-control" id="profiel-email-nieuw" placeholder="Voer e-mailadres in...">
                </div>

                <div class="mb-3">
                  <label class="form-label" for="profiel-email-bevestig">E-mailadres bevestigen <span class="text-danger">*</span></label>
                  <input type="email" class="form-control" id="profiel-email-bevestig" placeholder="Voer nogmaals het e-mailadres in...">
                </div>

                <p class="text-muted mb-3">Voer je huidige wachtwoord in om de wijziging te bevestigen.</p>

                <div class="mb-3">
                  <label class="form-label" for="profiel-email-wachtwoord">Wachtwoord <span class="text-danger">*</span></label>
                  <input type="password" class="form-control" id="profiel-email-wachtwoord" placeholder="Wachtwoord invoeren...">
                </div>

                <p class="small text-muted">Velden gemarkeerd met asterisks (*) zijn verplicht.</p>

                <button class="btn btn-dark" type="submit">Wijzigingen opslaan</button>
              </form>
            </div>

          </div>

        </div>

        <div class="tab-pane fade" id="pane-adressen" role="tabpanel">
          <h1 class="h3 mb-4">Adressen</h1>
          <p class="text-muted">Nog niet uitgewerkt in dit prototype.</p>
        </div>

        <div class="tab-pane fade" id="pane-betaalwijzen" role="tabpanel">
          <h1 class="h3 mb-4">Betaalwijzen</h1>
          <p class="text-muted">Nog niet uitgewerkt in dit prototype.</p>
        </div>

      </div>
    </main>
  </div>
</div>

<script slot="scripts">
  document.querySelectorAll('.js-tab-link').forEach(function(link){
    link.addEventListener('click', function(e){
      e.preventDefault();
      var target = this.getAttribute('data-bs-target');
      var navLink = document.querySelector('.account-nav .nav-link[data-bs-target="' + target + '"]');
      if (navLink) {
        bootstrap.Tab.getOrCreateInstance(navLink).show();
      }
    });
  });

  (function(){
    var newsletterToggle = document.getElementById('newsletter-toggle');
    var newsletterStatus = document.getElementById('newsletter-status');
    var newsletterSubtext = document.getElementById('newsletter-subtext');
    if (newsletterToggle && newsletterStatus && newsletterSubtext) {
      newsletterToggle.addEventListener('change', function(){
        newsletterStatus.textContent = newsletterToggle.checked ? 'Ingeschreven' : 'Uitgeschreven';
        newsletterSubtext.textContent = newsletterToggle.checked ? 'Je ontvangt onze nieuwsbrief' : 'Je ontvangt geen nieuwsbrief';
      });
    }
  })();

  (function(){
    var collapseEl = document.getElementById('accountNavCollapse');
    var toggleBtn = document.querySelector('.account-nav-toggle');
    var toggleIcon = toggleBtn ? toggleBtn.querySelector('i') : null;
    if (!collapseEl || !toggleIcon) return;

    collapseEl.addEventListener('show.bs.collapse', function(){
      toggleIcon.classList.replace('bi-chevron-down', 'bi-chevron-up');
    });
    collapseEl.addEventListener('hide.bs.collapse', function(){
      toggleIcon.classList.replace('bi-chevron-up', 'bi-chevron-down');
    });

    collapseEl.querySelectorAll('.account-nav .nav-link').forEach(function(link){
      link.addEventListener('click', function(){
        if (window.innerWidth < 992) {
          bootstrap.Collapse.getOrCreateInstance(collapseEl).hide();
        }
      });
    });
  })();
</script>
</BaseLayout>
