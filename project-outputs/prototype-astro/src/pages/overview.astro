---
const pageModules = import.meta.glob('./*.astro', { query: '?raw', import: 'default', eager: true });

const pages = Object.entries(pageModules)
  .map(([path, raw]) => {
    const slug = path.replace('./', '').replace('.astro', '');
    const titleMatch = raw.match(/<BaseLayout[^>]*\btitle=["']([^"']+)["']/);
    return {
      slug,
      title: titleMatch ? titleMatch[1] : slug,
      href: slug === 'index' ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}${slug}.html`,
    };
  })
  .filter((page) => page.slug !== 'overview')
  .sort((a, b) => a.slug.localeCompare(b.slug));
---
<!doctype html>
<html lang="nl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>SupraBazar | Prototype overview</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

<div class="container py-5">
  <h1 class="h3 mb-3">Paginaoverzicht</h1>
  <p class="text-muted mb-4" style="max-width:640px;">
    Alle pagina's die momenteel in dit prototype bestaan. Deze lijst wordt automatisch
    opgebouwd uit de bestanden in <code>src/pages/</code>, dus nieuwe pagina's verschijnen
    hier zonder dat deze lijst handmatig moet worden aangepast.
  </p>

  <ul class="list-group" style="max-width:640px;">
    {pages.map((page) => (
      <li class="list-group-item d-flex justify-content-between align-items-center">
        <div>
          <div class="fw-semibold">{page.title}</div>
          <div class="text-muted small">{page.slug}.astro</div>
        </div>
        <a href={page.href} class="btn btn-outline-dark btn-sm">Bekijk pagina</a>
      </li>
    ))}
  </ul>
</div>

</body>
</html>
