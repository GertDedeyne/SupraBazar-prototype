---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AccountSidebar from '../../components/AccountSidebar.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="SupraBazar | Retour aanvragen">

<div class="container py-4 account-main-container">
  <div class="row g-4">
    <aside class="col-lg-3">
      <AccountSidebar active="bestellingen" />
    </aside>

    <main class="col-lg-9">
      <a href={`${base}account/bestellingen.html`} class="d-inline-flex align-items-center gap-1 text-decoration-none link-secondary mb-3"><i class="bi bi-chevron-left"></i> Terug naar bestellingen</a>

      <h1 class="h3 mb-1">Retour aanvragen</h1>
      <p class="text-muted mb-4">Wens je je online bestelling te retourneren? Vul hieronder het herroepingsformulier in.</p>

      <form class="col-md-8" id="retour-form">
        <div class="row g-3 mb-3">
          <div class="col-sm-6">
            <label class="form-label" for="retour-voornaam">Voornaam <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="retour-voornaam" value="Jan" required>
          </div>
          <div class="col-sm-6">
            <label class="form-label" for="retour-achternaam">Achternaam <span class="text-danger">*</span></label>
            <input type="text" class="form-control mt-auto" id="retour-achternaam" value="Janssens" required>
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label" for="retour-email">E-mail <span class="text-danger">*</span></label>
          <input type="email" class="form-control" id="retour-email" value="jan.janssens@iodigital.com" required>
        </div>

        <div class="mb-3">
          <label class="form-label" for="retour-bestelnummer">Bestelnummer <span class="text-danger">*</span></label>
          <input type="text" class="form-control" id="retour-bestelnummer" required>
        </div>

        <div class="mb-3">
          <label class="form-label" for="retour-reden">Reden van retourneren <span class="text-danger">*</span></label>
          <textarea class="form-control" id="retour-reden" rows="4" required></textarea>
        </div>

        <p class="small text-muted">Velden gemarkeerd met asterisks (*) zijn verplicht.</p>

        <button class="btn btn-dark" type="submit">Verzenden</button>
      </form>
    </main>
  </div>
</div>

<script define:vars={{ bevestigingUrl: `${base}account/retour-bevestiging.html` }}>
  const params = new URLSearchParams(window.location.search);
  const orderId = params.get('bestelnummer');
  if (orderId) {
    const field = document.getElementById('retour-bestelnummer');
    if (field) field.value = orderId;
  }

  const form = document.getElementById('retour-form');
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      window.location.href = `${bevestigingUrl}?submitted=1`;
    });
  }
</script>
</BaseLayout>
