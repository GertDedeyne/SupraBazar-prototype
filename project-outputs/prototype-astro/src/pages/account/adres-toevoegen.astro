---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AccountSidebar from '../../components/AccountSidebar.astro';
import AddressPageForm from '../../components/AddressPageForm.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="SupraBazar | Adres toevoegen">

<div class="container py-4 account-main-container">
  <div class="row g-4">
    <aside class="col-lg-3">
      <AccountSidebar active="adressen" />
    </aside>

    <main class="col-lg-9">
      <a href={`${base}account/adressen.html`} class="d-inline-flex align-items-center gap-1 text-decoration-none link-secondary mb-3"><i class="bi bi-chevron-left"></i> Terug naar adressen</a>

      <h1 class="h3 mb-4">Nieuw adres toevoegen</h1>

      <AddressPageForm submitLabel="Adres opslaan" />
    </main>
  </div>
</div>

<script define:vars={{ redirectUrl: `${base}account/adressen.html` }}>
  const form = document.querySelector('.register-form');
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const get = (id) => document.getElementById(id)?.value?.trim() || '';
      const address = {
        id: 'addr-' + Date.now(),
        firstName: get('billingAddressFirstName'),
        lastName: get('billingAddressLastName'),
        street: get('billingAddressStreet'),
        houseNumber: get('billingAddressHouseNumber'),
        box: get('billingAddressBox'),
        zip: get('billingAddressZipcode'),
        city: get('billingAddressCity'),
        country: document.getElementById('billingAddressCountry')?.value || '',
      };
      let stored = JSON.parse(localStorage.getItem('sb-addresses') || 'null');
      if (!stored || !stored.length) {
        stored = [{ id: 'primary', firstName: 'Jan', lastName: 'Janssens', street: 'Raymonde De Larochelaan', houseNumber: '15', box: '', zip: '9051', city: 'Gent', country: 'België' }];
      }
      stored.push(address);
      localStorage.setItem('sb-addresses', JSON.stringify(stored));
      sessionStorage.setItem('sb-address-saved', '1');
      window.location.href = redirectUrl;
    });
  }
</script>
</BaseLayout>
