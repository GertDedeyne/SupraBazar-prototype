---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RegisterForm from '../../components/RegisterForm.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="SupraBazar | Account aanmaken">

<div class="container py-4">
  <a href={`${base}account/login.html`} class="d-inline-flex align-items-center gap-1 text-decoration-none link-secondary mb-3"><i class="bi bi-chevron-left"></i> Terug naar inloggen</a>

  <h1 class="h3 mb-4">Ik ben een nieuwe klant</h1>

  <RegisterForm />
</div>
</BaseLayout>
