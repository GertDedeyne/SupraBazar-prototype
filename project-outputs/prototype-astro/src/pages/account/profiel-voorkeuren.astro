---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AccountSidebar from '../../components/AccountSidebar.astro';
import FormSuccessAlert from '../../components/FormSuccessAlert.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="SupraBazar | Persoonlijke voorkeuren">

<div class="container py-4 account-main-container">
  <div class="row g-4">
    <aside class="col-lg-3">
      <AccountSidebar active="profiel" />
    </aside>

    <main class="col-lg-9">
      <a href={`${base}account/profiel.html`} class="d-inline-flex align-items-center gap-1 text-decoration-none link-secondary mb-3"><i class="bi bi-chevron-left"></i> Terug naar gegevens en voorkeuren</a>

      <h1 class="h3 mb-4">Persoonlijke voorkeuren</h1>

      <FormSuccessAlert />
      <form class="col-md-8">
        <div class="mb-3">
          <label class="form-label" for="profiel-ikben">Ik ben <span class="text-danger">*</span></label>
          <select class="form-select" id="profiel-ikben">
            <option>Particulier</option>
            <option>Zakelijk</option>
          </select>
        </div>

        <div class="mb-3">
          <label class="form-label" for="profiel-aanhef">Aanhef</label>
          <select class="form-select" id="profiel-aanhef">
            <option>Mr.</option>
            <option>Mevr.</option>
          </select>
        </div>

        <div class="mb-3">
          <label class="form-label" for="profiel-voornaam">Voornaam <span class="text-danger">*</span></label>
          <input type="text" class="form-control" id="profiel-voornaam" value="Jan">
        </div>

        <div class="mb-3">
          <label class="form-label" for="profiel-familienaam">Familienaam <span class="text-danger">*</span></label>
          <input type="text" class="form-control" id="profiel-familienaam" value="Janssens">
        </div>

        <p class="small text-muted">Velden gemarkeerd met asterisks (*) zijn verplicht.</p>

        <button class="btn btn-dark" type="submit">Wijzigingen opslaan</button>
      </form>
    </main>
  </div>
</div>
</BaseLayout>
