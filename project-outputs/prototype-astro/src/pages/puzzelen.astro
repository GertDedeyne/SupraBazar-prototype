<script slot="scripts">
  document.querySelectorAll('.price-slider').forEach(function(root){
    var minInput = root.querySelector('.price-range-min');
    var maxInput = root.querySelector('.price-range-max');
    var rangeEl = root.querySelector('.price-slider-range');
    var block = root.closest('.facet-block');
    var numMin = block ? block.querySelector('.price-num-min') : null;
    var numMax = block ? block.querySelector('.price-num-max') : null;
    var bound = parseFloat(minInput.max);

    function update(){
      var minVal = parseFloat(minInput.value);
      var maxVal = parseFloat(maxInput.value);
      if(minVal > maxVal){ minVal = maxVal; minInput.value = minVal; }
      rangeEl.style.left = (minVal / bound * 100) + '%';
      rangeEl.style.right = (100 - maxVal / bound * 100) + '%';
      if(numMin) numMin.value = minVal;
      if(numMax) numMax.value = maxVal;
    }
    minInput.addEventListener('input', update);
    maxInput.addEventListener('input', update);
    if(numMin) numMin.addEventListener('input', function(){ minInput.value = numMin.value; update(); });
    if(numMax) numMax.addEventListener('input', function(){ maxInput.value = numMax.value; update(); });
    update();
  });

  document.querySelectorAll('.js-brand-search').forEach(function(input){
    var scope = input.closest('.facet-block');
    if(!scope) return;
    var rows = scope.querySelectorAll('.brand-row');
    var noMatch = scope.querySelector('.brand-no-match');
    input.addEventListener('input', function(){
      var q = input.value.trim().toLowerCase();
      var visible = 0;
      rows.forEach(function(row){
        var match = row.dataset.brand.toLowerCase().includes(q);
        row.classList.toggle('d-none', !match);
        if(match) visible++;
      });
      if(noMatch) noMatch.classList.toggle('d-none', visible !== 0);
    });
  });

  (function(){
    var chipRows = [document.getElementById('chipRow')].filter(Boolean);
    var priceBlocks = document.querySelectorAll('.price-slider');
    var filterOffcanvas = document.getElementById('filterOffcanvas');
    var filterBadge = document.getElementById('filterCountBadge');

    function updateFilterBadge(){
      if(!filterBadge || !filterOffcanvas) return;
      var checked = filterOffcanvas.querySelectorAll('.form-check-input:checked').length;
      var hasPrice = chipRows.some(function(r){ return r.querySelector('.chip-price'); });
      var count = checked + (hasPrice ? 1 : 0);
      filterBadge.textContent = count;
      filterBadge.classList.toggle('d-none', count === 0);
    }

    function updateChipRowVisibility(){
      chipRows.forEach(function(chipRow){
        var any = chipRow.querySelector('.chip');
        chipRow.classList.toggle('d-none', !any);
      });
    }

    function renderPriceChip(min, max){
      chipRows.forEach(function(chipRow){
        var existing = chipRow.querySelector('.chip-price');
        var label = '€' + min + ' – €' + max;
        if(existing){
          existing.firstChild.textContent = label + ' ';
        } else {
          var chip = document.createElement('span');
          chip.className = 'chip chip-price';
          chip.append(label + ' ');
          var btn = document.createElement('button');
          btn.setAttribute('aria-label', 'verwijder');
          btn.textContent = '×';
          btn.addEventListener('click', removePriceChip);
          chip.append(btn);
          var clearAll = chipRow.querySelector('.clear-all');
          chipRow.insertBefore(chip, clearAll);
        }
      });
      updateChipRowVisibility();
      updateFilterBadge();
    }

    function removePriceChip(){
      chipRows.forEach(function(chipRow){
        var existing = chipRow.querySelector('.chip-price');
        if(existing) existing.remove();
      });
      updateChipRowVisibility();
      updateFilterBadge();
    }

    document.querySelectorAll('.js-price-apply').forEach(function(btn){
      btn.addEventListener('click', function(){
        var block = btn.closest('.facet-block');
        var minInput = block.querySelector('.price-num-min');
        var maxInput = block.querySelector('.price-num-max');
        renderPriceChip(minInput.value, maxInput.value);
      });
    });

    priceBlocks.forEach(function(root){
      var minInput = root.querySelector('.price-range-min');
      var maxInput = root.querySelector('.price-range-max');
      function syncIfApplied(){
        var chipRow = chipRows.find(function(r){ return r.querySelector('.chip-price'); });
        if(!chipRow) return;
        renderPriceChip(minInput.value, maxInput.value);
      }
      minInput.addEventListener('input', syncIfApplied);
      maxInput.addEventListener('input', syncIfApplied);
    });

    function buildFilterIndex(){
      var index = {};
      document.querySelectorAll(
        'aside [data-filter-key], #filterOffcanvas [data-filter-key]'
      ).forEach(function(cb){
        var key = cb.dataset.filterKey;
        if(!key) return;
        var label = cb.closest('.form-check').querySelector('.form-check-label');
        var text = label ? label.textContent.trim() : key;
        if(!index[key]) index[key] = { label: text, boxes: [] };
        index[key].boxes.push(cb);
      });
      return index;
    }

    function renderFilterChips(){
      chipRows.forEach(function(chipRow){
        chipRow.querySelectorAll('.chip:not(.chip-price)').forEach(function(c){ c.remove(); });
        var clearAll = chipRow.querySelector('.clear-all');
        Object.keys(filterIndex).forEach(function(key){
          var entry = filterIndex[key];
          if(!entry.boxes.some(function(b){ return b.checked; })) return;
          var chip = document.createElement('span');
          chip.className = 'chip';
          chip.dataset.filterKey = key;
          chip.append(entry.label + ' ');
          var btn = document.createElement('button');
          btn.setAttribute('aria-label', 'verwijder');
          btn.textContent = '×';
          btn.addEventListener('click', function(){ clearFilterKey(key); });
          chip.append(btn);
          chipRow.insertBefore(chip, clearAll);
        });
      });
      updateChipRowVisibility();
      updateFilterBadge();
    }

    function clearFilterKey(key){
      var entry = filterIndex[key];
      if(!entry) return;
      entry.boxes.forEach(function(b){ b.checked = false; });
      renderFilterChips();
    }

    var filterIndex = buildFilterIndex();
    Object.keys(filterIndex).forEach(function(key){
      filterIndex[key].boxes.forEach(function(cb){
        cb.addEventListener('change', function(){
          var checked = cb.checked;
          filterIndex[key].boxes.forEach(function(other){ other.checked = checked; });
          renderFilterChips();
        });
      });
    });

    document.querySelectorAll('.clear-all').forEach(function(a){
      a.addEventListener('click', function(e){
        e.preventDefault();
        Object.keys(filterIndex).forEach(function(key){
          filterIndex[key].boxes.forEach(function(b){ b.checked = false; });
        });
        removePriceChip();
        renderFilterChips();
      });
    });

    renderFilterChips();
  })();
</script>
