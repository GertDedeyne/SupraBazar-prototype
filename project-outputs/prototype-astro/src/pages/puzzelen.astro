---
<BaseLayout title="SupraBazar | Category">

<div class="container py-3">
  <nav aria-label="breadcrumb small">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href={import.meta.env.BASE_URL}>Home</a></li>
      <li class="breadcrumb-item"><a href="#">Speelgoed</a></li>
      <li class="breadcrumb-item active">Puzzelen</li>
    </ol>
  </nav>

  <div class="row">
    <!-- Desktop sidebar -->
    <aside class="col-lg-3 d-none d-lg-block">
      <div class="facet-bloc p-3 bg-body-secondary rounded">
        <div class="facet-title mb-2">Categorieën</div>
        <ul class="list-unstyled small">
          <li>Puzzels</li>
          <li><a href="#" class="text-decoration-none text-dark">Jan Van Haasteren Puzzels</a></li>
          <li><a href="#" class="text-decoration-none text-dark">3D Puzzels</a></li>
          <li><a href="#" class="text-decoration-none text-dark">Puzzel Accessoires</a></li>
        </ul>
      </div>

      <div class="facet-block">
        <div class="form-check d-flex justify-content-between">
          <span><input class="form-check-input" type="checkbox" id="f1" data-filter-key="f1"><label class="form-check-label ms-1" for="f1">Op voorraad</label></span>
          <span class="facet-count">(312)</span>
        </div>
        <div class="form-check d-flex justify-content-between mt-1">
          <span><input class="form-check-input" type="checkbox" id="f2" data-filter-key="f2"><label class="form-check-label ms-1" for="f2">In promotie</label></span>
          <span class="facet-count">(48)</span>
        </div>
        <div class="form-check d-flex justify-content-between mt-1">
          <span><input class="form-check-input" type="checkbox" id="f3" data-filter-key="f3"><label class="form-check-label ms-1" for="f3">Vaste lage prijs</label></span>
          <span class="facet-count">(96)</span>
        </div>
      </div>

      <div class="facet-block">
        <div class="facet-title mb-2">Merk</div>
        <div class="brand-search mb-2">
          <input type="search" class="form-control form-control-sm js-brand-search" placeholder="Zoek een merk…">
        </div>
        <div class="facet-scroll">
          <div class="form-check d-flex justify-content-between brand-row" data-brand="Bluey"><span><input class="form-check-input" type="checkbox" id="b1" data-filter-key="b1"><label class="form-check-label ms-1" for="b1">Bluey</label></span><span class="facet-count">(6)</span></div>
          <div class="form-check d-flex justify-content-between mt-1 brand-row" data-brand="Bumba"><span><input class="form-check-input" type="checkbox" id="b2" data-filter-key="b2"><label class="form-check-label ms-1" for="b2">Bumba</label></span><span class="facet-count">(14)</span></div>
          <div class="form-check d-flex justify-content-between mt-1 brand-row" data-brand="Cartonic"><span><input class="form-check-input" type="checkbox" id="b3" data-filter-key="b3"><label class="form-check-label ms-1" for="b3">Cartonic</label></span><span class="facet-count">(11)</span></div>
          <div class="form-check d-flex justify-content-between mt-1 brand-row" data-brand="Casterman"><span><input class="form-check-input" type="checkbox" id="b4" data-filter-key="b4"><label class="form-check-label ms-1" for="b4">Casterman</label></span><span class="facet-count">(4)</span></div>
          <div class="form-check d-flex justify-content-between mt-1 brand-row" data-brand="Clementoni"><span><input class="form-check-input" type="checkbox" id="b5" data-filter-key="b5"><label class="form-check-label ms-1" for="b5">Clementoni</label></span><span class="facet-count">(88)</span></div>
          <div class="form-check d-flex justify-content-between mt-1 brand-row" data-brand="Eugy"><span><input class="form-check-input" type="checkbox" id="b6" data-filter-key="b6"><label class="form-check-label ms-1" for="b6">Eugy</label></span><span class="facet-count">(9)</span></div>
          <div class="form-check d-flex justify-content-between mt-1 brand-row" data-brand="Friends"><span><input class="form-check-input" type="checkbox" id="b7" data-filter-key="b7"><label class="form-check-label ms-1" for="b7">Friends</label></span><span class="facet-count">(5)</span></div>
          <div class="form-check d-flex justify-content-between mt-1 brand-row" data-brand="Gabby's Poppenhuis"><span><input class="form-check-input" type="checkbox" id="b8" data-filter-key="b8"><label class="form-check-label ms-1" for="b8">Gabby's Poppenhuis</label></span><span class="facet-count">(7)</span></div>
          <div class="form-check d-flex justify-content-between mt-1 brand-row" data-brand="Harry Potter"><span><input class="form-check-input" type="checkbox" id="b9" data-filter-key="b9"><label class="form-check-label ms-1" for="b9">Harry Potter</label></span><span class="facet-count">(6)</span></div>
          <div class="form-check d-flex justify-content-between mt-1 brand-row" data-brand="Heller"><span><input class="form-check-input" type="checkbox" id="b10" data-filter-key="b10"><label class="form-check-label ms-1" for="b10">Heller</label></span><span class="facet-count">(3)</span></div>
          <div class="form-check d-flex justify-content-between mt-1 brand-row" data-brand="Jumbo"><span><input class="form-check-input" type="checkbox" id="b11" data-filter-key="b11"><label class="form-check-label ms-1" for="b11">Jumbo</label></span><span class="facet-count">(42)</span></div>
          <div class="form-check d-flex justify-content-between mt-1 brand-row" data-brand="K3"><span><input class="form-check-input" type="checkbox" id="b12" data-filter-key="b12"><label class="form-check-label ms-1" for="b12">K3</label></span><span class="facet-count">(8)</span></div>
          <div class="form-check d-flex justify-content-between mt-1 brand-row" data-brand="KPop Demon Hunters"><span><input class="form-check-input" type="checkbox" id="b13" data-filter-key="b13"><label class="form-check-label ms-1" for="b13">KPop Demon Hunters</label></span><span class="facet-count">(5)</span></div>
          <div class="form-check d-flex justify-content-between mt-1 brand-row" data-brand="L.O.L. Surprise!"><span><input class="form-check-input" type="checkbox" id="b14" data-filter-key="b14"><label class="form-check-label ms-1" for="b14">L.O.L. Surprise!</label></span><span class="facet-count">(12)</span></div>
          <div class="form-check d-flex justify-content-between mt-1 brand-row" data-brand="Lannoo"><span><input class="form-check-input" type="checkbox" id="b15" data-filter-key="b15"><label class="form-check-label ms-1" for="b15">Lannoo</label></span><span class="facet-count">(3)</span></div>
          <div class="form-check d-flex justify-content-between mt-1 brand-row" data-brand="Legacy Bricks"><span><input class="form-check-input" type="checkbox" id="b16" data-filter-key="b16"><label class="form-check-label ms-1" for="b16">Legacy Bricks</label></span><span class="facet-count">(6)</span></div>
          <div class="form-check d-flex justify-content-between mt-1 brand-row" data-brand="Lisciani"><span><input class="form-check-input" type="checkbox" id="b17" data-filter-key="b17"><label class="form-check-label ms-1" for="b17">Lisciani</label></span><span class="facet-count">(15)</span></div>
          <div class="form-check d-flex justify-content-between mt-1 brand-row" data-brand="Ravensburger"><span><input class="form-check-input" type="checkbox" id="b18" data-filter-key="b18"><label class="form-check-label ms-1" for="b18">Ravensburger</label></span><span class="facet-count">(96)</span></div>
          <div class="form-check d-flex justify-content-between mt-1 brand-row" data-brand="Rode Duivels"><span><input class="form-check-input" type="checkbox" id="b19" data-filter-key="b19"><label class="form-check-label ms-1" for="b19">Rode Duivels</label></span><span class="facet-count">(4)</span></div>
          <div class="form-check d-flex justify-content-between mt-1 brand-row" data-brand="Salto"><span><input class="form-check-input" type="checkbox" id="b20" data-filter-key="b20"><label class="form-check-label ms-1" for="b20">Salto</label></span><span class="facet-count">(3)</span></div>
          <div class="form-check d-flex justify-content-between mt-1 brand-row" data-brand="Smart"><span><input class="form-check-input" type="checkbox" id="b21" data-filter-key="b21"><label class="form-check-label ms-1" for="b21">Smart</label></span><span class="facet-count">(9)</span></div>
          <div class="form-check d-flex justify-content-between mt-1 brand-row" data-brand="Spin Master"><span><input class="form-check-input" type="checkbox" id="b22" data-filter-key="b22"><label class="form-check-label ms-1" for="b22">Spin Master</label></span><span class="facet-count">(11)</span></div>
          <div class="form-check d-flex justify-content-between mt-1 brand-row" data-brand="Stitch"><span><input class="form-check-input" type="checkbox" id="b23" data-filter-key="b23"><label class="form-check-label ms-1" for="b23">Stitch</label></span><span class="facet-count">(7)</span></div>
          <div class="text-muted small py-1 brand-no-match d-none">Geen merken gevonden.</div>
        </div>
      </div>

      <div class="facet-block">
        <button class="facet-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#facetGrootte" aria-expanded="true" aria-controls="facetGrootte">Puzzelgrootte <i class="bi bi-chevron-down"></i></button>
        <div class="collapse show" id="facetGrootte">
          <div class="form-check d-flex justify-content-between"><span><input class="form-check-input" type="checkbox" id="p1" data-filter-key="p1"><label class="form-check-label ms-1" for="p1">Minder dan 50 stukjes</label></span><span class="facet-count">(22)</span></div>
          <div class="form-check d-flex justify-content-between mt-1"><span><input class="form-check-input" type="checkbox" id="p2" data-filter-key="p2"><label class="form-check-label ms-1" for="p2">50-99 stukjes</label></span><span class="facet-count">(31)</span></div>
          <div class="form-check d-flex justify-content-between mt-1"><span><input class="form-check-input" type="checkbox" id="p3" data-filter-key="p3"><label class="form-check-label ms-1" for="p3">100-499 stukjes</label></span><span class="facet-count">(58)</span></div>
          <div class="collapse" id="grootteMore">
            <div class="form-check d-flex justify-content-between mt-1"><span><input class="form-check-input" type="checkbox" id="p4" data-filter-key="p4"><label class="form-check-label ms-1" for="p4">500-999 stukjes</label></span><span class="facet-count">(74)</span></div>
            <div class="form-check d-flex justify-content-between mt-1"><span><input class="form-check-input" type="checkbox" id="p5" data-filter-key="p5"><label class="form-check-label ms-1" for="p5">1000-1499 stukjes</label></span><span class="facet-count">(112)</span></div>
            <div class="form-check d-flex justify-content-between mt-1"><span><input class="form-check-input" type="checkbox" id="p6" data-filter-key="p6"><label class="form-check-label ms-1" for="p6">1500-1999 stukjes</label></span><span class="facet-count">(19)</span></div>
            <div class="form-check d-flex justify-content-between mt-1"><span><input class="form-check-input" type="checkbox" id="p7" data-filter-key="p7"><label class="form-check-label ms-1" for="p7">2000-2999 stukjes</label></span><span class="facet-count">(26)</span></div>
            <div class="form-check d-flex justify-content-between mt-1"><span><input class="form-check-input" type="checkbox" id="p8" data-filter-key="p8"><label class="form-check-label ms-1" for="p8">3000-3999 stukjes</label></span><span class="facet-count">(14)</span></div>
            <div class="form-check d-flex justify-content-between mt-1"><span><input class="form-check-input" type="checkbox" id="p9" data-filter-key="p9"><label class="form-check-label ms-1" for="p9">5000 stukjes &amp; meer</label></span><span class="facet-count">(9)</span></div>
          </div>
          <button class="show-more mt-1" type="button" data-bs-toggle="collapse" data-bs-target="#grootteMore" aria-expanded="false" aria-controls="grootteMore"><span class="more-label">Toon meer</span><span class="less-label">Toon minder</span></button>
        </div>
      </div>

      <div class="facet-block">
        <button class="facet-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#facetLeeftijd" aria-expanded="true" aria-controls="facetLeeftijd">Leeftijdscategorie <i class="bi bi-chevron-down"></i></button>
        <div class="collapse show" id="facetLeeftijd">
          <div class="form-check d-flex justify-content-between"><span><input class="form-check-input" type="checkbox" id="l1" data-filter-key="l1"><label class="form-check-label ms-1" for="l1">2 jaar</label></span><span class="facet-count">(28)</span></div>
          <div class="form-check d-flex justify-content-between mt-1"><span><input class="form-check-input" type="checkbox" id="l2" data-filter-key="l2"><label class="form-check-label ms-1" for="l2">3 jaar</label></span><span class="facet-count">(34)</span></div>
          <div class="form-check d-flex justify-content-between mt-1"><span><input class="form-check-input" type="checkbox" id="l3" data-filter-key="l3"><label class="form-check-label ms-1" for="l3">4 jaar</label></span><span class="facet-count">(41)</span></div>
          <div class="collapse" id="leeftijdMore">
            <div class="form-check d-flex justify-content-between mt-1"><span><input class="form-check-input" type="checkbox" id="l4" data-filter-key="l4"><label class="form-check-label ms-1" for="l4">5-6 jaar</label></span><span class="facet-count">(52)</span></div>
            <div class="form-check d-flex justify-content-between mt-1"><span><input class="form-check-input" type="checkbox" id="l5" data-filter-key="l5"><label class="form-check-label ms-1" for="l5">7-8 jaar</label></span><span class="facet-count">(47)</span></div>
            <div class="form-check d-flex justify-content-between mt-1"><span><input class="form-check-input" type="checkbox" id="l6" data-filter-key="l6"><label class="form-check-label ms-1" for="l6">9-12 jaar</label></span><span class="facet-count">(39)</span></div>
            <div class="form-check d-flex justify-content-between mt-1"><span><input class="form-check-input" type="checkbox" id="l7" data-filter-key="l7"><label class="form-check-label ms-1" for="l7">13 jaar en ouder</label></span><span class="facet-count">(61)</span></div>
            <div class="form-check d-flex justify-content-between mt-1"><span><input class="form-check-input" type="checkbox" id="l8" data-filter-key="l8"><label class="form-check-label ms-1" for="l8">volwassenen</label></span><span class="facet-count">(136)</span></div>
          </div>
          <button class="show-more mt-1" type="button" data-bs-toggle="collapse" data-bs-target="#leeftijdMore" aria-expanded="false" aria-controls="leeftijdMore"><span class="more-label">Toon meer</span><span class="less-label">Toon minder</span></button>
        </div>
      </div>

      <div class="facet-block">
        <button class="facet-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#facetGeslacht" aria-expanded="false" aria-controls="facetGeslacht">Geslacht <i class="bi bi-chevron-down"></i></button>
        <div class="collapse" id="facetGeslacht">
          <div class="form-check d-flex justify-content-between"><span><input class="form-check-input" type="checkbox" id="g1" data-filter-key="g1"><label class="form-check-label ms-1" for="g1">Voor elk geslacht</label></span><span class="facet-count">(401)</span></div>
          <div class="form-check d-flex justify-content-between mt-1"><span><input class="form-check-input" type="checkbox" id="g2" data-filter-key="g2"><label class="form-check-label ms-1" for="g2">Vrouwen</label></span><span class="facet-count">(156)</span></div>
          <div class="form-check d-flex justify-content-between mt-1"><span><input class="form-check-input" type="checkbox" id="g3" data-filter-key="g3"><label class="form-check-label ms-1" for="g3">Mannen</label></span><span class="facet-count">(162)</span></div>
        </div>
      </div>

      <div class="facet-block">
        <div class="facet-title mb-2">Prijs</div>
        <div class="d-flex gap-2 align-items-center mb-2">
          <div class="input-group input-group-sm">
            <span class="input-group-text">€</span>
            <input type="number" class="form-control price-num-min" placeholder="Min." value="20">
          </div>
          <span>–</span>
          <div class="input-group input-group-sm">
            <span class="input-group-text">€</span>
            <input type="number" class="form-control price-num-max" placeholder="Max." value="140">
          </div>
        </div>
        <div class="price-slider">
          <div class="price-slider-track"><div class="price-slider-range"></div></div>
          <input type="range" class="price-range price-range-min" min="0" max="200" step="1" value="20">
          <input type="range" class="price-range price-range-max" min="0" max="200" step="1" value="140">
        </div>
        <button type="button" class="btn btn-light btn-sm mt-2 js-price-apply">Toepassen</button>
      </div>
    </aside>

    <!-- Main column -->
    <main class="col-lg-9">
      <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
        <h1 class="h3 mb-0">Puzzelen</h1>

        <!-- mobile filter+sort group -->
        <div class="d-lg-none w-100 filter-sort-group d-flex mb-2">
          <button class="btn btn-filter flex-grow-1" type="button" data-bs-toggle="offcanvas" data-bs-target="#filterOffcanvas"><i class="bi bi-sliders"></i> Filter <span class="badge rounded-pill bg-light text-dark ms-1 d-none" id="filterCountBadge">0</span></button>
        </div>
      </div>

      <!-- Applied filters chips -->
      <div class="d-flex flex-wrap align-items-center gap-2 mb-2 d-none" id="chipRow">
        <a href="#" class="clear-all">Alles wissen</a>
      </div>

      <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="result-count"><strong id="resultCount">438</strong> resultaten</div>
        <div class="d-flex align-items-center gap-2">
          <label class="small text-muted mb-0">Sorteer op</label>
          <select class="form-select form-select-sm" style="width:auto;">
            <option>Naam, A-Z</option>
            <option>Prijs, laag-hoog</option>
            <option>Prijs, hoog-laag</option>
            <option>Populariteit</option>
            <option>Nieuwste eerst</option>
          </select>
        </div>
      </div>

      <div class="row g-3">
        {products.map((p) => (
          <div class="col-6 col-md-4">
            <div class="card card-product h-100">
              <div class="card-media">
                <img src={`${import.meta.env.BASE_URL}placeholder-img.png`} alt="Productafbeelding">
                <button class="wishlist-badge" type="button" aria-label="Voeg toe aan verlanglijst"><i class="bi bi-heart"></i></button>
              </div>
              <div class="card-body d-flex flex-column">
                <p class="mb-1 product-name">{p.name}</p>
                <p class="mb-1">€ {p.price}</p>
                <p class="small stock-ok mb-1"><i class="bi bi-check-circle"></i> Op voorraad</p>
                <p class="small text-muted mb-2">Leverbaar in 1 tot 2 werkdagen</p>
                <button class="btn btn-add w-100 mt-auto"><i class="bi bi-cart3"></i> Voeg toe</button>
              </div>
            </div>
          </div>
        ))}
      </div>

      <nav class="mt-4" aria-label="pagination">
        <ul class="pagination justify-content-center">
          <li class="page-item active"><a class="page-link" href="#" style="background:var(--g-darkest); border-color:var(--g-darkest);">1</a></li>
          <li class="page-item"><a class="page-link text-dark" href="#">2</a></li>
          <li class="page-item"><a class="page-link text-dark" href="#">3</a></li>
          <li class="page-item"><a class="page-link text-dark" href="#">4</a></li>
          <li class="page-item"><a class="page-link text-dark" href="#">Volgende</a></li>
        </ul>
      </nav>
    </main>
  </div>
</div>

<!-- Mobile filter offcanvas -->
<div class="offcanvas offcanvas-start offcanvas-filter" tabindex="-1" id="filterOffcanvas">
  <div class="offcanvas-header border-bottom">
    <h5 class="offcanvas-title">Filter</h5>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
  </div>
  <div class="offcanvas-body">
    <div class="facet-block">
      <div class="form-check d-flex justify-content-between"><span><input class="form-check-input" type="checkbox" data-filter-key="f1"><label class="form-check-label ms-1">Op voorraad</label></span><span class="facet-count">(312)</span></div>
      <div class="form-check d-flex justify-content-between mt-1"><span><input class="form-check-input" type="checkbox" data-filter-key="f2"><label class="form-check-label ms-1">In promotie</label></span><span class="facet-count">(48)</span></div>
      <div class="form-check d-flex justify-content-between mt-1"><span><input class="form-check-input" type="checkbox" data-filter-key="f3"><label class="form-check-label ms-1">Vaste lage prijs</label></span><span class="facet-count">(96)</span></div>
