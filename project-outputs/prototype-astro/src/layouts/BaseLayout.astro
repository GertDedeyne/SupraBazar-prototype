---
import TopBar from '../components/TopBar.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';

const { title } = Astro.props;
---
<!doctype html>
<html lang="nl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
<style is:global>
  /* Greyscale-only palette — no brand colors, icons inherit currentColor (monochrome) */
  :root{
    --g-darkest:#1a1a1a;
    --g-dark:#333333;
    --g-mid:#6b6b6b;
    --g-line:#d9d9d9;
    --g-light:#e9e9e9;
    --g-lighter:#f2f2f2;
  }
  html{ overflow-y:scroll; scrollbar-gutter:stable; }
  body{ font-family: -apple-system, "Segoe UI", Roboto, Arial, sans-serif; color:var(--g-darkest); display:flex; flex-direction:column; min-height:100vh; }
  a{ color:var(--g-dark); }
  a:hover{ color:var(--g-darkest); }
  .form-check-input:checked{ background-color:var(--g-darkest); border-color:var(--g-darkest); }
  .sb-topbar{ background:var(--g-darkest); color:#fff; font-size:.85rem; }
  .sb-topbar a{ color:#fff; text-decoration:none; }
  .sb-header{ background:var(--g-lighter); border-bottom:1px solid var(--g-line); }
  .sb-logo{ font-weight:800; font-size:1.6rem; line-height:1.2; color:var(--g-darkest); }
  .sb-logo small{ display:block; font-size:.85rem; font-weight:600; color:var(--g-mid); }
  .sb-navbar{ border-bottom:1px solid var(--g-line); }
  .sb-navbar a{ color:var(--g-darkest); text-decoration:none; font-weight:600; }
  .sb-nav-dropdown-toggle.show{ text-decoration:underline; }
  .sb-categories-menu{
    width:320px; padding:.5rem 0; border:none; border-radius:0 0 .5rem .5rem;
    box-shadow:0 .5rem 1.5rem rgba(0,0,0,.15);
  }
  .sb-categories-menu .dropdown-item{
    display:flex; align-items:center; justify-content:space-between; gap:.5rem;
    padding:.65rem 1.25rem; font-weight:400; color:var(--g-dark);
  }
  .sb-categories-menu .dropdown-item:hover{ background:var(--g-lighter); color:var(--g-darkest); }
  .sb-categories-menu .dropdown-item .bi{ color:var(--g-mid); }
  .breadcrumb-item a{ color:var(--g-dark); }
  .icon-link-group{ column-gap:1.5rem; }
  .icon-link-item{
    display:flex; flex-direction:column; align-items:center; gap:.2rem;
    color:var(--g-darkest); text-decoration:none; font-size:.7rem; font-weight:600;
    line-height:1.1;
  }
  .icon-link-item i{ font-size:1.3rem; }
  .icon-link-item:hover{ color:var(--g-dark); }

  .facet-title{ font-weight:700; font-size:.8rem; letter-spacing:.03em; text-transform:uppercase; color:var(--g-mid); }
  .facet-block{ border-bottom:1px solid var(--g-line); padding:.9rem 0; }
  .facet-count{ color:var(--g-mid); font-size:.8rem; }
  .form-check-label{ font-size:.92rem; }

  .chip{
    display:inline-flex; align-items:center; gap:.4rem;
    background:var(--g-lighter); border:1px solid var(--g-line); color:var(--g-darkest);
    border-radius:999px; padding:.3rem .7rem; font-size:.85rem; font-weight:600;
  }
  .chip button{
    border:none; background:none; color:var(--g-darkest); line-height:1; padding:0;
    font-weight:700; opacity:.6;
  }
  .chip button:hover{ opacity:1; }
  .clear-all{ font-size:.85rem; font-weight:600; text-decoration:underline; color:var(--g-dark); }

  .show-more{ background:none; border:none; padding:0; font-size:.8rem; font-weight:600; text-decoration:underline; color:var(--g-dark); }
  .show-more[aria-expanded="true"] .more-label{ display:none; }
  .show-more[aria-expanded="true"] .less-label{ display:inline; }
  .show-more .less-label{ display:none; }

  .result-count{ font-size:.95rem; color:var(--g-dark); }
  .result-count strong{ color:var(--g-darkest); }

  .brand-search input{ font-size:.85rem; }

  .card-product{ border:1px solid var(--g-line); overflow:hidden; }
  .btn-add{
    background:var(--g-darkest); border-color:var(--g-darkest); color:#fff; font-weight:700;
  }
  .btn-add:hover{ background:var(--g-dark); border-color:var(--g-dark); color:#fff; }
  .btn-add i{ margin-right:.5rem; }
  .stock-ok{ color:var(--g-dark); }

  .product-name{
    display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical;
    overflow:hidden; line-height:1.3; font-weight:500;
  }

  .card-media{ position:relative; }
  .card-media img{ width:100%; aspect-ratio:4/3; object-fit:cover; display:block; }
  .wishlist-badge{
    position:absolute; top:.5rem; right:.5rem;
    width:32px; height:32px; border-radius:50%; background:#fff;
    display:flex; align-items:center; justify-content:center;
    box-shadow:0 1px 3px rgba(0,0,0,.25); border:none; padding:4px 0 0; color:var(--g-darkest);
  }

  .filter-sort-group{ border:1px solid var(--g-line); border-radius:.5rem; overflow:hidden; }
  .filter-sort-group > *{ border:none !important; border-radius:0 !important; }
  .filter-sort-group .btn-filter{ background:var(--g-darkest); color:#fff; font-weight:700; }
  .filter-sort-group .form-select{ background-color:#fff; }

  .facet-toggle{
    display:flex; justify-content:space-between; align-items:center; width:100%;
    background:none; border:none; padding:0; margin-bottom:.5rem;
    font-weight:700; font-size:.8rem; letter-spacing:.03em; text-transform:uppercase;
    color:var(--g-mid); cursor:pointer;
  }
  .facet-toggle .bi{ transition:transform .15s; font-size:.85rem; }
  .facet-toggle[aria-expanded="true"] .bi-chevron-down{ transform:rotate(180deg); }
  .facet-scroll{ max-height:220px; overflow-y:auto; padding-right:.3rem; }

  .price-slider{ position:relative; height:28px; margin-top:.5rem; }
  .price-slider-track{ position:absolute; top:50%; left:0; right:0; height:4px; background:var(--g-line); border-radius:2px; transform:translateY(-50%); }
  .price-slider-range{ position:absolute; top:0; height:4px; background:var(--g-darkest); border-radius:2px; }
  .price-range{ position:absolute; top:0; left:0; width:100%; height:28px; margin:0; background:none; pointer-events:none; -webkit-appearance:none; appearance:none; }
  .price-range::-webkit-slider-runnable-track{ background:none; }
  .price-range::-moz-range-track{ background:none; border:none; }
  .price-range::-webkit-slider-thumb{ pointer-events:auto; -webkit-appearance:none; appearance:none; width:24px; height:24px; border-radius:50%; background:var(--g-darkest); border:3px solid #fff; box-shadow:0 0 0 1px var(--g-line); cursor:pointer; margin-top:2px; }
  .price-range::-moz-range-thumb{ pointer-events:auto; width:24px; height:24px; border-radius:50%; background:var(--g-darkest); border:3px solid #fff; box-shadow:0 0 0 1px var(--g-line); cursor:pointer; }

  .annot{
    display:none;
    background:var(--g-lighter); border:1px dashed var(--g-mid); border-radius:.4rem;
    padding:.4rem .6rem; font-size:.72rem; color:var(--g-dark); margin-top:.3rem;
  }
  .qw-badge{
    display:inline-block; background:var(--g-darkest); color:#fff; font-size:.65rem;
    font-weight:700; border-radius:.3rem; padding:.1rem .4rem; margin-left:.35rem; vertical-align:middle;
  }

  .offcanvas-filter .facet-block{ padding:1rem 0; }
  .offcanvas-filter{ display:flex; flex-direction:column; }
  .offcanvas-filter .offcanvas-body{ flex:1 1 auto; overflow-y:auto; }
  .offcanvas-filter .offcanvas-footer{ flex-shrink:0; padding:1rem; border-top:1px solid var(--g-line); background:#fff; }

  .page-wrap{ flex:1 0 auto; display:flex; flex-direction:column; }
  .account-main-container{ flex:1 0 auto; }

  .account-nav a{ color:var(--g-darkest); text-decoration:none; display:flex; align-items:center; gap:.5rem; padding:.4rem .75rem; background:none; border:none; border-radius:.375rem; }
  .account-nav a:hover{ text-decoration:underline; color:var(--g-darkest); background:none; }
  .account-nav.nav-pills .nav-link.active{ font-weight:700; color:var(--g-darkest) !important; background:var(--g-light) !important; }
  .account-nav.nav-pills .nav-link.active i{ color:var(--g-darkest) !important; }
  .logout{ color:var(--g-dark); text-decoration:none; }
  .logout:hover{ color:var(--g-darkest); text-decoration:underline; }

  .account-nav-panel{ border:1px solid var(--g-line); border-radius:.5rem; overflow:hidden; }
  .account-nav-toggle{ border-radius:0; padding:.75rem 1rem; }
  .account-nav-toggle[aria-expanded="true"]{ border-bottom:1px solid var(--g-line); }
  @media (min-width: 992px){
    .account-nav-panel{ border:0; border-radius:0; overflow:visible; }
  }

  .badge-status{ font-weight:600; font-size:.78rem; padding:.35rem .8rem; border-radius:50rem; display:inline-flex; align-items:center; gap:.35rem; }
  .order-card-muted{ opacity:.55; }

  .stepper{ display:flex; align-items:center; }
  .stepper .dot{ width:22px; height:22px; border-radius:50%; background:var(--g-light); border:1px solid var(--g-line); display:flex; align-items:center; justify-content:center; font-size:.85rem; color:#fff; }
  .stepper .dot.done{ background:var(--g-darkest); border-color:var(--g-darkest); }
  .stepper .dot.current{ background:#fff; border:2px solid var(--g-darkest); }
  .stepper .bar{ flex:1; height:3px; background:var(--g-light); }
  .stepper .bar.done{ background:var(--g-darkest); }
  .stepper-label{ font-size:.7rem; color:var(--g-mid); }

  .order-card{ border:1px solid var(--g-line); background:var(--g-lighter); border-radius:.5rem; }

  .order-row{ border-top:1px solid var(--g-line); padding:1.25rem 0; }

  .btn-return{ color:var(--g-dark); font-size:.82rem; text-decoration:underline; }
  .btn-return:hover{ color:var(--g-darkest); }

  .card-title-label{ font-weight:700; font-size:.8rem; letter-spacing:.03em; text-transform:uppercase; color:var(--g-mid); margin-bottom:.75rem; }

  .account-card{ border:1px solid var(--g-line); background:var(--g-lighter); border-radius:.5rem; }
  .btn-light{ border:1px solid var(--g-line); }

  .suprakaart-card{ background:var(--g-mid); color:#fff; border-radius:.6rem; }
  .suprakaart-card .card-title-label{ color:#fff; opacity:.75; }
  .suprakaart-card .giftcard-balance{ color:#fff; }
  .suprakaart-card .welcome-text{ color:#fff; }
  .suprakaart-points{ font-size:1.8rem; font-weight:800; }
  .progress-bar-mono{ background:#fff; }

  .giftcard-balance{ font-size:1.8rem; font-weight:800; color:var(--g-darkest); }
  .welcome-text{ font-size:1.8rem; font-weight:800; color:var(--g-darkest); }

  .sb-footer{ background:var(--g-lighter); margin-top:3rem; }
  .sb-footer-usps .bi{ font-size:1.7rem; color:var(--g-darkest); flex-shrink:0; }
  .footer-usp-title{ font-weight:700; font-size:.9rem; }
  .footer-usp-desc{ font-size:.8rem; color:var(--g-mid); }
  .sb-footer-trustpilot{ background:#fff; font-size:.9rem; color:var(--g-dark); }
  .trustpilot-stars{ color:var(--g-mid); font-size:.95rem; letter-spacing:.1rem; }
  .sb-footer-cta{ background:var(--g-darkest); color:#fff; }
  .sb-footer-cta-title{ font-weight:800; font-size:1.1rem; text-decoration:underline; text-decoration-color:var(--g-line); }
  .captcha-image{
    font-family:monospace; font-weight:700; letter-spacing:.1rem; font-size:1.1rem;
    background:
      linear-gradient(45deg,var(--g-light) 25%,transparent 25%,transparent 75%,var(--g-light) 75%) 0 0/10px 10px,
      linear-gradient(45deg,var(--g-light) 25%,transparent 25%,transparent 75%,var(--g-light) 75%) 5px 5px/10px 10px,
      #fff;
    border:1px solid var(--g-line); border-radius:.375rem; padding:.3rem .9rem;
  }
  .sb-footer-accordion .accordion-button{ font-weight:700; font-size:.9rem; color:var(--g-darkest); background:none; box-shadow:none; }
  .sb-footer-accordion .accordion-button:not(.collapsed){ background:none; color:var(--g-darkest); }
  .sb-footer-accordion .accordion-button::after{ display:none; }
  .sb-footer-accordion .accordion-button::before{
    content:"+"; font-weight:400; font-size:1.2rem; margin-left:auto; order:2; line-height:1;
  }
  .sb-footer-accordion .accordion-button:not(.collapsed)::before{ content:"\2212"; }
  .sb-footer-accordion .accordion-item{ background:none; border:none; border-bottom:1px solid var(--g-line); }
  .sb-footer-accordion .accordion-body{ padding-top:0; }
  .sb-footer-heading{ font-weight:700; font-size:.8rem; letter-spacing:.03em; text-transform:uppercase; color:var(--g-mid); margin-bottom:.9rem; }
  .footer-link{ color:var(--g-dark); text-decoration:none; font-size:.88rem; }
  .footer-link:hover{ color:var(--g-darkest); text-decoration:underline; }
  .sb-footer-hours li{ display:flex; justify-content:space-between; gap:.5rem; font-size:.85rem; color:var(--g-dark); }
  .sb-footer-social a{
    width:36px; height:36px; border-radius:50%; border:1px solid var(--g-line);
    display:flex; align-items:center; justify-content:center; color:var(--g-darkest); background:#fff;
  }
  .sb-footer-social a:hover{ background:var(--g-darkest); color:#fff; }
  .back-to-top{
    width:36px; height:36px; border-radius:50%; border:1px solid var(--g-line);
    display:flex; align-items:center; justify-content:center; color:var(--g-darkest); background:#fff;
    flex-shrink:0;
  }
  .back-to-top:hover{ background:var(--g-darkest); color:#fff; }

  .breadcrumb{
    font-size: .875em;
  }
  .card{
    /* -bs-card-border-radius: 0; */
  }
  .sb-footer-accordion .accordion-button, .sb-footer-accordion .accordion-body { padding-left: 0; padding-right:0;}
  .sb-footer-accordion .accordion-body{ padding-bottom: 24px;}
  .sb-footer-accordion .accordion-item{ border-radius:0;}

</style>
</head>
<body>
<div class="page-wrap">
  <TopBar />
  <SiteHeader />
  <SiteNav />
  <slot />
  <SiteFooter />
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<slot name="scripts" />
</body>
</html>
